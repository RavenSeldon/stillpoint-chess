{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "WebWorker"], "module": "ES2022",
    "moduleResolution": "Bundler", "strict": true, "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "outDir": "dist/assets", "rootDir": "src", "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
